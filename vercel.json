{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {"api/*.js": {"maxDuration": 60}},
  "headers": [
    {"source": "/api/(.*)", "headers": [{"key": "Cache-Control", "value": "no-store"}]}
  ]
}
